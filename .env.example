# ─────────────────────────────────────────────────────────────
# RAID Academy — environment variables
# Copy to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Registration storage (Supabase) ──────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Supabase → Project Settings → API.
# The anon key is enough: the RLS policy in supabase/schema.sql
# allows anonymous INSERT into `registrations` and nothing else.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Public contact details ───────────────────────────────────
# Leave empty to hide. Do NOT put placeholder numbers here —
# whatever you enter is shown publicly.
# WhatsApp in international format, digits only, e.g. 2010XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Location (shown on the Contact page). Leave empty until confirmed.
NEXT_PUBLIC_ADDRESS_AR=
NEXT_PUBLIC_ADDRESS_EN=
# Google Maps → Share → Embed a map → copy only the src="..." URL
NEXT_PUBLIC_MAP_EMBED_URL=
NEXT_PUBLIC_MAP_LINK_URL=
